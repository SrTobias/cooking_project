# OpenAI - usado para o LLM e para os embeddings
OPENAI_API_KEY=sk-...

# Modelos (opcional, estes são os valores por defeito)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Score mínimo de relevância (0-1) para um documento recuperado ser usado como contexto
RELEVANCE_THRESHOLD=0.25

# LangSmith - opcional, ativa tracing/dashboard/feedback
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=cooking-rag-assistant

# Chroma Cloud - opcional. Se definidas, a app usa a base de dados vetorial alojada
# na cloud (chromadb.CloudClient) em vez de um diretório local (chroma_db/).
# Deixa por preencher para usar ChromaDB local (não precisa de conta nem chave).
CHROMA_API_KEY=ck-...
CHROMA_TENANT=...
CHROMA_DATABASE=cooking-rag-assistant
